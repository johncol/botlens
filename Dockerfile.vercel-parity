FROM public.ecr.aws/lambda/nodejs:24 AS builder

WORKDIR ${LAMBDA_TASK_ROOT}
ENV NEXT_TELEMETRY_DISABLED=1 \
    VERCEL_PARITY_BUILD=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build \
    && test -f .next/standalone/node_modules/@sparticuz/chromium/bin/chromium.br

FROM public.ecr.aws/lambda/nodejs:24

WORKDIR ${LAMBDA_TASK_ROOT}
ENV HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    PORT=3001 \
    VERCEL=1

COPY --from=builder ${LAMBDA_TASK_ROOT}/.next/standalone ./
COPY --from=builder ${LAMBDA_TASK_ROOT}/.next/static ./.next/static
COPY --from=builder ${LAMBDA_TASK_ROOT}/public ./public
COPY --from=builder ${LAMBDA_TASK_ROOT}/scripts/vercel-parity-smoke.mjs ./scripts/vercel-parity-smoke.mjs

ENTRYPOINT ["node"]
CMD ["scripts/vercel-parity-smoke.mjs"]