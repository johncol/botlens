# Playwright - use system Chrome to avoid downloading Chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# If set, a login gate will be used to access the site
GATE_PASSWORD=

# Optional Human vs Bot prefills (development only)
DOMAIN=
PAGE=

STAGING_USER=
STAGING_PASSWORD=

DEVELOPMENT_USER=
DEVELOPMENT_PASSWORD=

UAT_USER=
UAT_PASSWORD=

# Optional crawler comparison tunables (omit to use built-in defaults)
SCROLL_MAX=           # default: 10
PAGE_TIMEOUT_MS=      # default: 60000
MAX_HTML_BYTES=       # default: 2097152 (2 MB)
